POSTGRES_DB=gdsc_sharing_platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=GdscSharingPlatform.Api
JWT_AUDIENCE=GdscSharingPlatform.Web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_CLOCK_SKEW_SECONDS=0

# Required by Docker Compose; choose strong, distinct passwords before starting.
# Both variables are required even when the corresponding seed is disabled.
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
