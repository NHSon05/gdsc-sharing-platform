# Browser API requests use same-origin Next.js BFF routes.
NEXT_PUBLIC_API_URL=
# Server-only origins (no paths, query strings, or trailing API prefixes).
APP_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_ORIGIN=https://localhost:7160
INTERNAL_API_URL=http://localhost:5184
# Also used by the public /uploads proxy; fallback for INTERNAL_API_URL.
BACKEND_API_URL=http://localhost:5184
# Production origins must use HTTPS. Never put Google secrets in NEXT_PUBLIC_*.
